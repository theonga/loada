NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://user:password@localhost:5432/loada
REDIS_URL=redis://localhost:6379

# JWT — generate with: openssl rand -hex 64
JWT_SECRET=change_me_minimum_64_characters_long_random_string_for_production_use
JWT_REFRESH_SECRET=change_me_minimum_64_characters_long_random_refresh_secret_here
# If not set, ADMIN_JWT_SECRET falls back to JWT_SECRET
ADMIN_JWT_SECRET=change_me_separate_64_char_secret_for_admin_tokens_production_use

# Phone-number HMAC pepper. Used for the User.phoneHash lookup index.
# MUST stay constant across the cluster — rotating it invalidates every login lookup.
# Generate once with: openssl rand -hex 32
# Store separately from the database (e.g. AWS Secrets Manager).
PHONE_PEPPER=change_me_random_32_byte_hex_string

# Admin seed (used once by npm run db:seed — change password immediately after)
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_PASSWORD=changeme123

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=us-east-1

GOOGLE_MAPS_API_KEY=

FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

BULKIT_SMS_USERNAME=your-bulkit-email@example.com
BULKIT_SMS_PASSWORD=your-bulkit-password
BULKIT_SMS_SENDER=YourSenderID
BULKIT_SMS_API_URL=https://api.npr.bulkit.co.zw/api/messages/send
SMS_DRY_RUN=False

PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=
PAYNOW_AUTH_EMAI=

SENTRY_DSN=
